{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Econ–Management Meta Protocol Amendment",
  "type": "object",
  "required": [
    "amendment_id", "created_at", "approved_by", "from_version", "to_version",
    "change_type", "original_rule", "new_rule", "rationale", "outcome_information_seen",
    "affected_artifacts", "confirmatory_status_after_change"
  ],
  "additionalProperties": false,
  "properties": {
    "amendment_id": {"type": "string", "pattern": "^AMD-[A-F0-9]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "approved_by": {"type": "string", "minLength": 2},
    "from_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "to_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "change_type": {
      "enum": ["CLARIFICATION", "PROSPECTIVE_MINOR_AMENDMENT", "PROSPECTIVE_MAJOR_AMENDMENT", "POST_OUTCOME_AMENDMENT", "PROTOCOL_DEVIATION"]
    },
    "original_rule": {"type": "string", "minLength": 1},
    "new_rule": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "outcome_information_seen": {
      "type": "object",
      "required": ["study_level_results", "pooled_results"],
      "additionalProperties": false,
      "properties": {
        "study_level_results": {"type": "boolean"},
        "pooled_results": {"type": "boolean"}
      }
    },
    "affected_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confirmatory_status_after_change": {
      "enum": ["CONFIRMATORY", "AMENDED_PROSPECTIVELY", "POST_OUTCOME_EXPLORATORY", "PROTOCOL_DEVIATION"]
    }
  }
}
